# === AUDIT ILS — tasks/main.yml ===

- name: Init artefacts
  file:
    path: "{{ artifacts_dir | default(playbook_dir ~ '/artifacts') }}"
    state: directory
    mode: "0755"

- name: Defaults
  set_fact:
    ns: "{{ ns | default(namespace | default('ibm-licensing')) }}"
    artifacts_dir: "{{ artifacts_dir | default(playbook_dir ~ '/artifacts') }}"
    audit_ts: "{{ lookup('pipe','date +%Y%m%dT%H%M%S') }}"
    _services_expected: "{{ services | default(['ibm-licensing-service-instance','ibm-licensing-service-prometheus']) }}"
    _crd_names: "{{ crd_names | default([
      'ibmlicensingdefinitions.operator.ibm.com',
      'ibmlicensingmetadatas.operator.ibm.com',
      'ibmlicensingquerysources.operator.ibm.com',
      'ibmlicensings.operator.ibm.com'
    ]) }}"

# --- Outils ---
- name: oc
  command: oc version --client
  register: oc_cli
  changed_when: false
  failed_when: false
- debug: { msg: "{{ 'OK  - oc présent' if (oc_cli.rc|default(1))==0 else 'KO  - oc absent' }}" }

- name: helm
  command: helm version --short
  register: helm_cli
  changed_when: false
  failed_when: false
- debug: { msg: "{{ 'OK  - helm présent' if (helm_cli.rc|default(1))==0 else 'KO  - helm absent' }}" }

# --- Namespace ---
- name: Namespace
  kubernetes.core.k8s_info:
    api_version: v1
    kind: Namespace
    name: "{{ ns }}"
  register: nsinfo
  failed_when: false
- set_fact: { ns_present: "{{ (nsinfo.resources|default([])|length)>0 }}" }
- debug: { msg: "{{ 'OK  - namespace ' ~ ns ~ ' actif' if ns_present else 'KO  - namespace ' ~ ns ~ ' absent' }}" }

# --- CRDs ---
- name: CRDs
  kubernetes.core.k8s_info:
    api_version: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    name: "{{ item }}"
  loop: "{{ _crd_names }}"
  register: crd_checks
  failed_when: false
- set_fact:
    crd_found_count: "{{ (crd_checks.results|default([])|map(attribute='resources')|list|map('length')|sum(start=0))|int }}"
- debug: { msg: "{{ 'OK  - CRDs présents' if crd_found_count|int>0 else 'KO  - CRDs absents' }}" }

# --- Deployments ---
- name: Dep operator
  kubernetes.core.k8s_info:
    api_version: apps/v1
    kind: Deployment
    namespace: "{{ ns }}"
    name: ibm-licensing-operator
  register: depop
  failed_when: false
- debug:
    msg: >-

- name: Dep instance
  kubernetes.core.k8s_info:
    api_version: apps/v1
    kind: Deployment
    namespace: "{{ ns }}"
    name: ibm-licensing-service-instance
  register: depinst
  failed_when: false
- debug:
    msg: >-

# --- Services ---
- name: Services
  kubernetes.core.k8s_info:
    api_version: v1
    kind: Service
    namespace: "{{ ns }}"
  register: svcs
  failed_when: false
- set_fact:
    _svcs_all: "{{ svcs.resources | default([]) }}"
    have_svcs: "{{ (svcs.resources | default([]) | map(attribute='metadata.name') | list) | default([]) }}"
- debug:
    msg: >-

# --- Routes ---
- name: Lister Routes
  kubernetes.core.k8s_info:
    api_version: route.route.openshift.io/v1
    kind: Route
    namespace: "{{ ns }}"
  register: routes
  failed_when: false

# scinder la sélection pour éviter _routes indéfini
- name: Routes → liste brute
  set_fact:
    _routes: "{{ routes.resources | default([]) }}"

- name: Routes → sélections
  set_fact:
    _by_service: "{{ _routes | selectattr('spec.to.name','defined') | selectattr('spec.to.name','search','licens') | list }}"
    _by_name:    "{{ _routes | selectattr('metadata.name','search','licens') | list }}"

- name: Routes → objet choisi
  set_fact:
    ils_route_obj: "{{ (_by_service|length>0) | ternary(_by_service[0], ((_by_name|length>0)|ternary(_by_name[0], {}))) }}"

- name: Routes → host + tls
  set_fact:
    ils_host: "{{ ils_route_obj.spec.host | default('') }}"
    tls_term: "{{ ils_route_obj.spec.tls.termination | default('') }}"

- debug: { msg: "{{ (ils_host|length>0) | ternary('OK  - Route: ' ~ ils_host, 'KO  - Aucune Route') }}" }
- debug:
    msg: "{{ (tls_term=='reencrypt') | ternary('OK  - TLS reencrypt','INFO- TLS: ' ~ (tls_term|default(''))) }}"
  when: ils_host|length > 0

# --- Secret token ---
- name: Secret token
  kubernetes.core.k8s_info:
    api_version: v1
    kind: Secret
    namespace: "{{ ns }}"
    name: ibm-licensing-token
  register: tok
  failed_when: false
- debug: { msg: "{{ 'OK  - secret token' if (tok.resources|default([])|length)>0 else 'KO  - pas de token' }}" }
- set_fact:
    ils_token: "{{ (tok.resources[0].data.token | b64decode) if ((tok.resources|default([])|length)>0 and (tok.resources[0].data.token|default(''))|length>0) else '' }}"

# --- API service + PF ---
- set_fact:
    api_svc: >-
- set_fact:
    api_svc_obj: "{{ (_svcs_all | selectattr('metadata.name','equalto', api_svc) | list | first) | default({}) }}"
- name: Auto-detect API port
  set_fact:
    api_service_port: "{{ (api_svc_obj.spec.ports | list | first).port | default(8080) }}"
- set_fact:
    api_service_port: >-
    api_local_port: "{{ api_local_port | default(18443) }}"
    api_pf_pid_file: "{{ artifacts_dir }}/pf_api.pid"

# --- Checks via Route ---
- name: /version via Route
  when: ils_host|length > 0
  uri:
    url: "https://{{ ils_host }}/version"
    method: GET
    validate_certs: no
  register: version_http_route
  retries: 10
  delay: 3
  until: (version_http_route.status | default(0) | int) == 200
  failed_when: false

- name: /health via Route
  when: ils_host|length > 0 and ils_token|length > 0
  uri:
    url: "https://{{ ils_host }}/health?token={{ ils_token | urlencode }}"
    method: GET
    validate_certs: no
  register: health_http_route
  retries: 10
  delay: 3
  until: (health_http_route.status | default(0) | int) == 200
  failed_when: false

# --- PF API si route KO ---
- name: Stop PF API
  shell: "pkill -f \"port-forward.*{{ api_local_port }}:{{ api_service_port }}\" || true"
  changed_when: false
  failed_when: false

- name: Start PF API
  when: (ils_host|length==0) or ((version_http_route.status|default(0)|int)!=200)
  shell: |
    set -e
    nohup oc -n {{ ns }} port-forward svc/{{ api_svc }} {{ api_local_port }}:{{ api_service_port }} --address 127.0.0.1 >/dev/null 2>&1 &
    echo $! > "{{ api_pf_pid_file }}"
  changed_when: false
  failed_when: false

- name: Wait PF API
  when: (ils_host|length==0) or ((version_http_route.status|default(0)|int)!=200)
  wait_for:
    host: 127.0.0.1
    port: "{{ api_local_port }}"
    timeout: 60

- name: /version via PF
  when: (ils_host|length==0) or ((version_http_route.status|default(0)|int)!=200)
  uri:
    url: "https://127.0.0.1:{{ api_local_port }}/version"
    method: GET
    validate_certs: no
  register: version_http_pf
  retries: 10
  delay: 3
  until: (version_http_pf.status | default(0) | int) == 200
  failed_when: false

- name: /health via PF
  when: ((ils_host|length==0) or ((version_http_route.status|default(0)|int)!=200)) and (ils_token|length>0)
  uri:
    url: "https://127.0.0.1:{{ api_local_port }}/health?token={{ ils_token | urlencode }}"
    method: GET
    validate_certs: no
  register: health_http_pf
  retries: 10
  delay: 3
  until: (health_http_pf.status | default(0) | int) == 200
  failed_when: false

- name: Stop PF API (cleanup)
  shell: |
    test -f "{{ api_pf_pid_file }}" && kill $(cat "{{ api_pf_pid_file }}") >/dev/null 2>&1 || true
    rm -f "{{ api_pf_pid_file }}"
  changed_when: false
  failed_when: false

# --- Prometheus /metrics ---
- set_fact:
    prom_svc: >-
- set_fact:
    prom_svc_obj: "{{ (_svcs_all | selectattr('metadata.name','equalto', prom_svc) | list | first) | default({}) }}"
- set_fact:
    prom_service_port: >-
    prom_local_port: "{{ health_portforward_local_port | default(18082) }}"
    prom_pf_pid_file: "{{ artifacts_dir }}/pf_prom.pid"
- debug: { msg: "PF Prom: svc={{ prom_svc }} port={{ prom_service_port }} -> 127.0.0.1:{{ prom_local_port }}" }
- set_fact:
    prom_svc: "{{ (_svcs_all | map(attribute='metadata.name') | list | select('equalto','ibm-licensing-service-prometheus') | list | first | default('ibm-licensing-service-prometheus', true)) }}"
- set_fact:
    prom_svc_obj: "{{ (_svcs_all | selectattr('metadata.name','equalto', prom_svc) | list | first | default({}, true)) }}"
- set_fact:
    prom_service_port: "{{ (prom_svc_obj.spec.ports | list | first).port | default(8081, true) }}"

- name: Stop PF Prom
  shell: "pkill -f \"port-forward.*{{ prom_local_port }}:{{ prom_service_port }}\" || true"
  changed_when: false
  failed_when: false

- name: Start PF Prom
  shell: |
    set -e
    nohup oc -n {{ ns }} port-forward svc/{{ prom_svc }} {{ prom_local_port }}:{{ prom_service_port }} --address 127.0.0.1 >/dev/null 2>&1 &
    echo $! > "{{ prom_pf_pid_file }}"
  changed_when: false
  failed_when: false

- name: Wait PF Prom
  wait_for:
    host: 127.0.0.1
    port: "{{ prom_local_port }}"
    timeout: 30

- name: GET /metrics
  uri:
    url: "https://127.0.0.1:{{ prom_local_port }}/metrics"
    method: GET
    validate_certs: no
  register: metrics_http
  retries: 15
  delay: 2
  until: (metrics_http.status | default(0) | int) == 200
  failed_when: false
  changed_when: false

- name: Stop PF Prom (cleanup)
  shell: |
    test -f "{{ prom_pf_pid_file }}" && kill $(cat "{{ prom_pf_pid_file }}") >/dev/null 2>&1 || true
    rm -f "{{ prom_pf_pid_file }}"
  changed_when: false
  failed_when: false

- debug: { msg: "{{ 'OK  - /metrics 200' if (metrics_http.status|default(0)|int)==200 else 'KO  - /metrics' }}" }

# --- Export snapshot ---
- block:
    - name: Export /snapshot via Route
      when: ils_host|length>0 and ils_token|length>0
      get_url:
        url: "https://{{ ils_host }}/snapshot?token={{ ils_token | urlencode }}"
        dest: "{{ artifacts_dir }}/ils-snapshot-{{ audit_ts }}.zip"
        validate_certs: no
        force: true
      register: export_res_route
      failed_when: false

    - name: Export /snapshot via PF
      when: (export_res_route.status|default(0)|int)!=200 and ils_token|length>0 and (version_http_pf.status|default(0)|int)==200
      get_url:
        url: "https://127.0.0.1:{{ api_local_port }}/snapshot?token={{ ils_token | urlencode }}"
        dest: "{{ artifacts_dir }}/ils-snapshot-{{ audit_ts }}.zip"
        validate_certs: no
        force: true
      register: export_res_pf
      failed_when: false

    - name: Fallback /api/v1/export
      when: ((export_res_route.status|default(0)|int)!=200) and ((export_res_pf.status|default(0)|int)!=200) and ils_token|length>0
      get_url:
        url: >-
          {{
            (ils_host|length>0)
            | ternary(
                'https://' ~ ils_host ~ '/api/v1/export?token=' ~ (ils_token | urlencode),
                'https://127.0.0.1:' ~ (api_local_port | string) ~ '/api/v1/export?token=' ~ (ils_token | urlencode)
              )
          }}
        dest: "{{ artifacts_dir }}/ils-snapshot-{{ audit_ts }}.zip"
        validate_certs: no
        force: true
      register: export_res_legacy
      failed_when: false

    - name: Export OK/KO
      debug:
        msg: >-
          {{
            (export_res_route.dest|default('')|length>0) or
            (export_res_pf.dest|default('')|length>0) or
            (export_res_legacy.dest|default('')|length>0)
            | ternary('OK  - snapshot exporté','KO  - export snapshot KO')
          }}
  rescue:
    - debug: { msg: "KO  - export snapshot échoué" }

# --- Bilan ---
- set_fact:
    v_status: "{{ (version_http_route is defined and (version_http_route.status|default(0)|int)>0) | ternary((version_http_route.status|int), (version_http_pf.status|default(0)|int)) }}"
    h_status: "{{ (health_http_route  is defined and (health_http_route.status |default(0)|int)>0) | ternary((health_http_route.status |int), (health_http_pf.status |default(0)|int)) }}"
    m_status: "{{ metrics_http.status | default(0) | int }}"

- set_fact:
    v_ok: "{{ (v_status|int) == 200 }}"
    h_ok: "{{ (h_status|int) == 200 }}"
    m_ok: "{{ (m_status|int) == 200 }}"
    # Ne dépend pas de v_ok/h_ok/m_ok pour éviter les ordres d’évaluation ambigus
    audit_ok: "{{ ((v_status|int)==200) and ((h_status|int)==200) and ((m_status|int)==200) }}"

- debug:
    msg: "Codes: version={{ v_status }} health={{ h_status }} metrics={{ m_status }}"

- debug:
    msg: |
      ==== Résultat ====
      Version: {{ 'OK' if v_ok else 'KO' }}
      Health : {{ 'OK' if h_ok else 'KO' }}
      Metrics: {{ 'OK' if m_ok else 'KO' }}
      AUDIT: {{ 'OK' if audit_ok else 'KO' }}
